NODE_ENV=development
PORT=5001

# Database
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/

# CORS
# Comma-separated list. Wildcard (*) is intentionally ignored by backend safeguards.
CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:3000

# Auth
JWT_ACCESS_SECRET=your_super_secret_access_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
MAX_REQUESTS_PER_MINUTE=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# AI provider
AI_PROVIDER=gemini
AI_FALLBACK_ENABLED=true

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Translation
GOOGLE_TRANSLATE_API_KEY=
KANNADA_POST_TRANSLATE=false

# TTS
TTS_PROVIDER=browser
TTS_MAX_DATA_URL_BYTES=450000

# ElevenLabs (when TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_KN=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.4
ELEVENLABS_SIMILARITY_BOOST=0.75

# AWS Polly (when TTS_PROVIDER=aws-polly)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_POLLY_ENGINE=neural
AWS_POLLY_VOICE_ID_EN=Joanna
AWS_POLLY_VOICE_ID_KN=Aditi

# Sign-language
SIGN_LANGUAGE_PROVIDER=lexicon-demo
SIGN_LANGUAGE_COMING_SOON=false

# Optional Redis cache
REDIS_URL=
AI_CACHE_TTL_SECONDS=3600

# Logging
LOG_LEVEL=debug
